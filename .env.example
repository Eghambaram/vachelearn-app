# VacheLearn local development placeholders only. Never put real secrets in Git.
# Required by the API (no default, so a deploy that forgets it fails instead of running with development settings).
NODE_ENV=development

# Web app (port 3000 in `pnpm dev`)
# Where the web server reaches the API (server-only, never sent to browsers). Browsers call /api/v1 on the web origin,
# which forwards there (D-085). Baked into the /api/v1 rewrite at build time: rebuild after changing it.
API_INTERNAL_URL=http://localhost:4000
# Developer token sheet at /design (not a secret). Unset: on in `next dev`, off in production builds.
ENABLE_DESIGN_GALLERY=
# Demo workspaces + demo role switcher (D-063; not a secret). Unset: on in `next dev`, off (404) in production builds.
# Never set to true on a deployed environment.
ENABLE_DEMO_WORKSPACES=
# Public certificate verification on demo data at /verify (D-074; not a secret). Unset: on in `next dev`, off (404) in
# production builds. Never set to true on an internet-facing environment: it would "verify" fake certificates.
ENABLE_DEMO_VERIFICATION=
# Sample data for signed-in users + demo catalog/enrol + public tenant pages /t/<slug> (D-110, D-111; not a secret).
# Off unless exactly true, also in `next dev`. Local client demos only: never on a deployed environment.
ENABLE_DEMO_CONTENT=

# API (apps/api, validated at boot by src/config/env.ts — a missing or malformed value stops start-up)
API_PORT=4000
# Interface the API listens on. Unset: every interface (containers, CI). 127.0.0.1 for a local demo on a shared network.
API_HOST=
# The only browser origin allowed to call the API (CORS). A bare origin (no path or trailing slash); https and
# required when NODE_ENV=production.
WEB_ORIGIN=http://localhost:3000
# OpenAPI at /api/docs: unset = on in development only. Cannot be enabled in production.
ENABLE_API_DOCS=
# Signs list cursors (HMAC, ≥ 32 characters). Required in production (generate with `openssl rand -base64 48`);
# when unset elsewhere a random key is used per process, so cursors stop working after a restart.
# CURSOR_SECRET=replace-with-a-long-random-value
# Signs each session's CSRF token (HMAC, ≥ 32 characters). Required in production; random per process elsewhere,
# so local sessions stop working after an API restart — the placeholder below keeps them across restarts locally.
SESSION_SECRET=replace-with-random-local-secret
# Local demo data only (`pnpm --filter api db:seed`): the password for accounts the seed creates (≥ 12 characters).
# Unset: a random one is printed once. Never used outside a local dev or test database.
# SEED_PASSWORD=choose-a-local-demo-passphrase
# Proxies in front of the API whose X-Forwarded-For is trusted (a hop count, never "true"). Required in production —
# count only the proxies in front of the WEB app that append the client address to X-Forwarded-For (load balancer,
# CDN). The web app's /api proxy forwards the header unchanged and adds nothing, so it is not counted. 0 locally
# (nothing in front of the web app); at least 1 in production. Keep the API and the web app reachable only through
# that proxy, or clients choose their own IP.
TRUST_PROXY_HOPS=0

# Local services (infra/docker-compose.yml). Host ports avoid the standard ones so they never collide with another
# project's Postgres or Mailpit. POSTGRES_PASSWORD is a local placeholder, not a credential.
VL_POSTGRES_PORT=55432
VL_SMTP_PORT=51025
VL_MAILPIT_UI_PORT=58025
POSTGRES_PASSWORD=change-me

# PostgreSQL — local development database only (D-005)
DATABASE_URL=postgresql://vachelearn:change-me@localhost:55432/vachelearn
# Integration tests: must name a database ending in "_test" (apps/api/test/global-setup.ts refuses anything else).
TEST_DATABASE_URL=postgresql://vachelearn:change-me@localhost:55432/vachelearn_test

# Storage adapter — not used before Phase 3; the local S3-compatible server is chosen then (D-078: MinIO no longer
# publishes images). Placeholders only.
STORAGE_PROVIDER=s3-compatible
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vachelearn-local
STORAGE_ACCESS_KEY=local-development-only
STORAGE_SECRET_KEY=local-development-only
STORAGE_FORCE_PATH_STYLE=true

# Video provider — configure only after provider decision
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_API_KEY=

# Email (validated at boot). console = log masked recipient + subject only, never the body (no links reach you);
# smtp = send, e.g. to the local Mailpit (UI http://localhost:58025). Production requires smtp and EMAIL_FROM; the
# production provider is D-082 (Needs decision). SMTP_USER and SMTP_PASSWORD go together; leave both empty locally.
EMAIL_PROVIDER=smtp
EMAIL_FROM=VacheLearn (Demo) <no-reply@example.invalid>
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Background jobs (D-040): unset = run the in-process worker (off when NODE_ENV=test).
JOBS_WORKER=

# Payments — do not enable until a provider and policies are approved
PAYMENT_PROVIDER=disabled
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Observability (API log level: fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=debug
# Error tracking: not read yet (chosen before production, Phase 7).
ERROR_TRACKING_DSN=
