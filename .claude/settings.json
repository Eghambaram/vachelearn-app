{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm build)",
      "Bash(pnpm verify)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * test:isolation)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter api db:migrate)",
      "Bash(pnpm --filter api db:seed)",
      "Bash(docker compose -f infra/docker-compose.yml ps)",
      "Bash(docker compose -f infra/docker-compose.yml logs *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(node -v)",
      "Bash(pnpm -v)",
      "Bash(docker --version)",
      "Bash(git --version)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm --filter * add *)",
      "Bash(pnpm --filter api db:reset)",
      "Bash(npx prisma migrate reset *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(docker compose * down *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf /*)",
      "Bash(prisma db push --force-reset *)",
      "Bash(npx prisma db push --force-reset *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ]
  }
}
