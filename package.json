{
  "name": "vachelearn",
  "private": true,
  "description": "VacheLearn \u2014 multi-tenant industrial learning and workforce-readiness platform",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.8.1"
  },
  "scripts": {
    "dev": "pnpm --filter @vachelearn/contracts build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "verify": "pnpm check:ignored-source && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:ignored-source": "node scripts/check-ignored-source.mjs",
    "services:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
