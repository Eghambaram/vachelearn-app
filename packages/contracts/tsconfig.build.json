{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS JavaScript + declarations for apps/api (a compiled NestJS app cannot load TypeScript source).
    // apps/web and every test keep importing src/ directly (package.json "exports": require → dist, default → src).
    "module": "commonjs",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
