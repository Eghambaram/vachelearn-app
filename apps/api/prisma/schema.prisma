// VacheLearn database schema (D-005: PostgreSQL + Prisma 7). Conventions: .claude/rules/database.md — UUID v7 keys
// (Postgres 18 `uuidv7()`), snake_case via @map/@@map, tenant-owned models carry tenant_id with composite foreign keys
// so the database itself rejects cross-tenant links. CHECK constraints and the audit trigger live in the migration SQL.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // The API compiles to CommonJS (NestJS); the generated client must match, with extensionless relative imports.
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ── Tenancy (Slice 2.2) ────────────────────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  active
  suspended
  archived

  @@map("tenant_status")
}

/// D-048 fixed list.
enum Industry {
  manufacturing
  construction
  oil_and_gas
  logistics
  utilities
  other

  @@map("industry")
}

/// Global (not tenant-owned): the tenant itself. Slug fixed once created (D-079).
model Tenant {
  id                  String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug                String       @unique @db.VarChar(40)
  displayName         String       @map("display_name") @db.VarChar(120)
  status              TenantStatus @default(active)
  defaultTimezone     String       @map("default_timezone") @db.VarChar(64)
  defaultLocale       String       @default("en-IN") @map("default_locale") @db.VarChar(35)
  primaryContactEmail String?      @map("primary_contact_email") @db.VarChar(254)
  industry            Industry?
  suspendedAt         DateTime?    @map("suspended_at") @db.Timestamptz(3)
  suspendedReason     String?      @map("suspended_reason") @db.VarChar(500)
  suspendedById       String?      @map("suspended_by_id") @db.Uuid
  archivedAt          DateTime?    @map("archived_at") @db.Timestamptz(3)
  archivedReason      String?      @map("archived_reason") @db.VarChar(500)
  archivedById        String?      @map("archived_by_id") @db.Uuid
  /// Optimistic-concurrency token: every update must name the version it read.
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById         String?      @map("created_by_id") @db.Uuid
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings        TenantSetting?
  branches        Branch[]
  auditEvents     AuditEvent[]
  jobs            Job[]
  memberships     Membership[]
  supportSessions PlatformSupportSession[]

  @@index([status, createdAt])
  @@map("tenants")
}

/// Tenant-owned, one row per tenant. Feature flags (D-031), all off by default.
model TenantSetting {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  classroomEnabled     Boolean  @default(false) @map("classroom_enabled")
  surveysEnabled       Boolean  @default(false) @map("surveys_enabled")
  commerceEnabled      Boolean  @default(false) @map("commerce_enabled")
  publicCatalogEnabled Boolean  @default(false) @map("public_catalog_enabled")
  analyticsEnabled     Boolean  @default(false) @map("analytics_enabled")
  version              Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

enum BranchStatus {
  active
  inactive

  @@map("branch_status")
}

/// Tenant-owned. Code unique within the tenant only (spec §4 AC). Deactivation keeps history (never deleted).
model Branch {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  code              String       @db.VarChar(20)
  name              String       @db.VarChar(120)
  timezone          String       @db.VarChar(64)
  addressLine       String?      @map("address_line") @db.VarChar(200)
  city              String?      @db.VarChar(100)
  region            String?      @db.VarChar(100)
  countryCode       String?      @map("country_code") @db.Char(2)
  status            BranchStatus @default(active)
  deactivatedAt     DateTime?    @map("deactivated_at") @db.Timestamptz(3)
  deactivatedReason String?      @map("deactivated_reason") @db.VarChar(500)
  deactivatedById   String?      @map("deactivated_by_id") @db.Uuid
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       String?      @map("created_by_id") @db.Uuid
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  auditEvents        AuditEvent[]
  membershipBranches MembershipBranch[]
  primaryFor         Membership[]       @relation("PrimaryBranch")
  roleAssignments    RoleAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status, name])
  @@map("branches")
}

/// Evidence: insert-only (a trigger rejects UPDATE and DELETE). Tenant-owned when tenantId is set, else platform.
/// The branch link is composite, so an event can never point at another tenant's branch.
model AuditEvent {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// The user who acted (null for system jobs).
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  tenantId         String?  @map("tenant_id") @db.Uuid
  branchId         String?  @map("branch_id") @db.Uuid
  /// `resource.verb_past`, e.g. `tenant.suspended`.
  action           String   @db.VarChar(80)
  entityType       String   @map("entity_type") @db.VarChar(60)
  entityId         String   @map("entity_id") @db.Uuid
  requestId        String?  @map("request_id") @db.VarChar(64)
  /// Set when platform staff act inside a support session (D-037, Slice 2.4).
  supportSessionId String?  @map("support_session_id") @db.Uuid
  reason           String?  @db.VarChar(500)
  /// Safe subset of changed fields only — never secrets or personal free text.
  before           Json?
  after            Json?

  tenant         Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch?                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  actor          User?                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  supportSession PlatformSupportSession? @relation(fields: [tenantId, supportSessionId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ── Jobs and email (Slice 2.3a, D-040) ─────────────────────────────────────────────────────────────────────────────

enum JobStatus {
  queued
  running
  retrying
  succeeded
  failed
}

/// Postgres-backed job/outbox row (D-040). Written in the same transaction as the change that needs it, run after
/// commit by the in-process worker. `(type, business_key)` is unique, so enqueueing the same work twice is a no-op.
/// The payload is validated per job type and never holds secrets (D-081: tokens are minted when an email is sent).
model Job {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        String    @db.VarChar(80)
  businessKey String    @map("business_key") @db.VarChar(200)
  /// The tenant the work belongs to, when it has one (handlers re-check tenant status before acting).
  tenantId    String?   @map("tenant_id") @db.Uuid
  payload     Json
  status      JobStatus @default(queued)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  runAfter    DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by") @db.VarChar(100)
  /// Sanitised: error type and scrubbed message only — never a token, link, address or payload value.
  lastError   String?   @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  tenant   Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  delivery EmailDelivery?

  @@unique([type, businessKey])
  @@index([status, runAfter])
  @@index([tenantId])
  @@map("jobs")
}

enum EmailDeliveryStatus {
  sending
  sent
}

/// One per email job: a retry after a successful send sees `sent` and does not send again. Holds no address or body.
model EmailDelivery {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId     String              @unique @map("job_id") @db.Uuid
  /// Stable per job (`<job-{id}@…>`), so a provider or mail client can recognise a resend after a crash.
  messageId String              @map("message_id") @db.VarChar(200)
  provider  String              @db.VarChar(40)
  status    EmailDeliveryStatus @default(sending)
  attempts  Int                 @default(1)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@map("email_deliveries")
}

// ── Identity and sessions (Slice 2.3b, D-010 / D-049 / D-084) ──────────────────────────────────────────────────────

enum UserStatus {
  active
  deactivated
}

/// Global identity (domain model §2): one person, any number of tenant memberships (2.4). Never deleted once it has
/// history; deactivation ends every session on the next request (D-049).
model User {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Case-insensitive and unique across the platform.
  email             String     @unique @db.Citext
  displayName       String     @map("display_name") @db.VarChar(120)
  locale            String?    @db.VarChar(20)
  timezone          String?    @db.VarChar(64)
  status            UserStatus @default(active)
  /// Set when the user follows a set-password link (D-083); no sign-in before.
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  deactivatedAt     DateTime?  @map("deactivated_at") @db.Timestamptz(3)
  deactivatedReason String?    @map("deactivated_reason") @db.VarChar(500)
  deactivatedById   String?    @map("deactivated_by_id") @db.Uuid
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       String?    @map("created_by_id") @db.Uuid
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential      UserCredential?
  sessions        AuthSession[]
  auditEvents     AuditEvent[]
  passwordLinks   PasswordLink[]
  memberships     Membership[]
  platformRoles   PlatformRoleAssignment[]
  supportSessions PlatformSupportSession[]

  @@map("users")
}

/// The password hash lives apart from `users`, so no ordinary user query can select it by accident.
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  /// PHC string: `$argon2id$v=19$m=…,t=…,p=…$salt$hash` (D-051).
  passwordHash String   @map("password_hash") @db.VarChar(200)
  changedAt    DateTime @map("changed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

enum SessionEndReason {
  signed_out
  idle_timeout
  expired
  user_deactivated
  password_changed
}

/// Opaque server-side session (D-010). The cookie holds a random token; only its SHA-256 is stored. Checked on every
/// request: 8 hours idle or 7 days after creation, whichever comes first (D-084).
model AuthSession {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  tokenHash          String            @unique @map("token_hash") @db.Char(64)
  createdAt          DateTime          @map("created_at") @db.Timestamptz(3)
  lastSeenAt         DateTime          @map("last_seen_at") @db.Timestamptz(3)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(3)
  endedAt            DateTime?         @map("ended_at") @db.Timestamptz(3)
  endReason          SessionEndReason? @map("end_reason")
  /// The active tenant membership (D-089). Composite key: a session can only point at its own user's membership.
  activeMembershipId String?           @map("active_membership_id") @db.Uuid
  /// A live platform support session opened from this browser session (D-037); while live it replaces the membership.
  supportSessionId   String?           @map("support_session_id") @db.Uuid

  user             User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeMembership Membership?              @relation(fields: [userId, activeMembershipId], references: [userId, id], onDelete: Restrict)
  supportSession   PlatformSupportSession?  @relation("ActiveSupport", fields: [userId, supportSessionId], references: [staffUserId, id], onDelete: Restrict)
  openedSupport    PlatformSupportSession[] @relation("OpenedFrom")

  @@unique([userId, id])
  @@index([userId, endedAt])
  @@map("auth_sessions")
}

/// Fixed-window counters for rate limits (no Redis, D-040 spirit). Keys hold hashes, never an address or IP in clear.
model RateLimitBucket {
  key         String   @id @db.VarChar(120)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("rate_limit_buckets")
}

// ── Password links (Slice 2.3c, D-081 / D-083 / D-087) ────────────────────────────────────────────────────────────

enum PasswordLinkPurpose {
  set_password
  reset_password
}

/// A single-use emailed link to set or reset a password. Minted when the email is sent (D-081); only the token's
/// SHA-256 is stored. A newer link of the same purpose revokes the older one (partial unique index in the migration).
model PasswordLink {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   PasswordLinkPurpose
  tokenHash String              @unique @map("token_hash") @db.Char(64)
  /// The email job that delivered it (one job may mint again on retry, revoking its own earlier link).
  jobId     String?             @map("job_id") @db.Uuid
  createdAt DateTime            @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime?           @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("password_links")
}

// ── Memberships and roles (Slice 2.4a, D-026 / D-053 / D-089) ────────────────────────────────────────────────────

enum MembershipStatus {
  active
  deactivated
}

/// A user's membership of one tenant (domain model §2): the global identity stays separate from tenant membership.
model Membership {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  status            MembershipStatus @default(active)
  /// Used for branch comparisons in reports (D-026); must be one of the member's branches (checked in the service).
  primaryBranchId   String?          @map("primary_branch_id") @db.Uuid
  deactivatedAt     DateTime?        @map("deactivated_at") @db.Timestamptz(3)
  deactivatedReason String?          @map("deactivated_reason") @db.VarChar(500)
  deactivatedById   String?          @map("deactivated_by_id") @db.Uuid
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       String?          @map("created_by_id") @db.Uuid
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryBranch   Branch?            @relation("PrimaryBranch", fields: [tenantId, primaryBranchId], references: [tenantId, id], onDelete: Restrict)
  branches        MembershipBranch[]
  roleAssignments RoleAssignment[]
  activeSessions  AuthSession[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@unique([userId, id])
  @@index([userId, status])
  @@map("memberships")
}

/// The branches a member belongs to (D-026: any number; one is primary).
model MembershipBranch {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?  @map("created_by_id") @db.Uuid

  membership      Membership       @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  branch          Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  roleAssignments RoleAssignment[]

  @@id([membershipId, branchId])
  @@index([tenantId, branchId])
  @@map("membership_branches")
}

enum TenantRole {
  tenant_admin
  branch_admin
  learning_manager
  instructor
  learner
  compliance_viewer
}

/// A fixed role (D-053) held tenant-wide (`branch_id` null) or on one branch. Revoked, never deleted (audit history).
model RoleAssignment {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  membershipId  String     @map("membership_id") @db.Uuid
  role          TenantRole
  branchId      String?    @map("branch_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?    @map("created_by_id") @db.Uuid
  revokedAt     DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokedById   String?    @map("revoked_by_id") @db.Uuid
  revokedReason String?    @map("revoked_reason") @db.VarChar(500)

  membership       Membership        @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  /// A branch role sits on one of the member's own branches: removing that branch is refused while the role is live
  /// or revoked (history keeps it) — revoke and keep, or move members only through the membership service.
  membershipBranch MembershipBranch? @relation(fields: [membershipId, branchId], references: [membershipId, branchId], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, membershipId])
  @@map("role_assignments")
}

enum PlatformRole {
  platform_super_admin
}

/// Platform staff role. Grants platform routes only — never tenant data (D-037 support sessions are separate).
model PlatformRoleAssignment {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  role          PlatformRole
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?      @map("created_by_id") @db.Uuid
  revokedAt     DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokedById   String?      @map("revoked_by_id") @db.Uuid
  revokedReason String?      @map("revoked_reason") @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("platform_role_assignments")
}

// ── Platform support sessions (Slice 2.4c, D-037 / D-098) ────────────────────────────────────────────────────────

enum SupportSessionEndReason {
  ended
  expired
  signed_out
  tenant_archived
  staff_role_revoked
}

/// Platform staff's only way into a tenant (D-037): explicit, reason required, read-only (the matrix's SS permissions),
/// 60 minutes at most, bound to the browser session that opened it. Every request inside it is audited with its id.
model PlatformSupportSession {
  id            String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  staffUserId   String                   @map("staff_user_id") @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  authSessionId String                   @map("auth_session_id") @db.Uuid
  reason        String                   @db.VarChar(500)
  startedAt     DateTime                 @map("started_at") @db.Timestamptz(3)
  expiresAt     DateTime                 @map("expires_at") @db.Timestamptz(3)
  endedAt       DateTime?                @map("ended_at") @db.Timestamptz(3)
  endReason     SupportSessionEndReason? @map("end_reason")

  staff       User          @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  authSession AuthSession   @relation("OpenedFrom", fields: [staffUserId, authSessionId], references: [userId, id], onDelete: Restrict)
  activeIn    AuthSession[] @relation("ActiveSupport")
  auditEvents AuditEvent[]

  @@unique([staffUserId, id])
  @@unique([tenantId, id])
  @@index([tenantId, startedAt])
  @@index([staffUserId, endedAt])
  @@map("platform_support_sessions")
}
