{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "VacheLearn API: NestJS modular monolith (D-003), REST /api/v1, PostgreSQL via Prisma (D-005).",
  "scripts": {
    "generate": "prisma generate",
    "contracts": "pnpm --filter @vachelearn/contracts build",
    "build": "pnpm contracts && pnpm generate && tsc -p tsconfig.build.json",
    "dev": "pnpm build && pnpm run --parallel \"/^dev:/\"",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:node": "node --watch --enable-source-maps --env-file-if-exists=../../.env dist/src/main.js",
    "start": "node --enable-source-maps dist/src/main.js",
    "user:create": "pnpm build && node --enable-source-maps --env-file-if-exists=../../.env dist/src/cli/create-user.js",
    "user:grant": "pnpm build && node --enable-source-maps --env-file-if-exists=../../.env dist/src/cli/grant-role.js",
    "lint": "eslint .",
    "typecheck": "pnpm contracts && pnpm generate && tsc --noEmit",
    "test": "pnpm generate && vitest run",
    "test:isolation": "pnpm generate && vitest run isolation",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "node scripts/assert-local-database.mjs && prisma migrate reset --force"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vachelearn/contracts": "workspace:*",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "^5.0.5"
  }
}
